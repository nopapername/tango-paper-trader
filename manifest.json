{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.3.47",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://gmgn.ai/*",
    "https://api.coingecko.com/*",
    "https://api.dexscreener.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "commands": {
    "toggle-paper-trading-master": {
      "suggested_key": {
        "default": "Alt+Shift+Y"
      },
      "description": "__MSG_toggleDescription__"
    }
  },
  "options_page": "dashboard.html",
  "content_scripts": [
    {
      "matches": [
        "https://gmgn.ai/*"
      ],
      "css": [
        "src/content/quick-buy-safety.css"
      ],
      "js": [
        "src/shared/constants.js",
        "src/content/native-quick-buy-guard.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://gmgn.ai/*"
      ],
      "js": [
        "src/core/chains.js",
        "src/core/supply.js",
        "src/adapters/gmgn-quotes.js",
        "src/shared/trade-replay.js",
        "src/content/page-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://gmgn.ai/*"
      ],
      "js": [
        "src/content/chart-main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://gmgn.ai/*"
      ],
      "css": [
        "src/content/content.css"
      ],
      "js": [
        "src/core/chains.js",
        "src/core/supply.js",
        "src/shared/constants.js",
        "src/core/state.js",
        "src/shared/i18n.js",
        "src/shared/format.js",
        "src/core/engine.js",
        "src/core/state-coordinator.js",
        "src/core/storage.js",
        "src/shared/daily-report.js",
        "src/shared/trade-replay.js",
        "src/adapters/gmgn-quotes.js",
        "src/adapters/gmgn.js",
        "src/content/chain-view.js",
        "src/content/markers.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dashboard.html",
        "src/content/content.css"
      ],
      "matches": [
        "https://gmgn.ai/*"
      ]
    }
  ],
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "default_locale": "zh_CN"
}
