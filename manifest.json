{
  "manifest_version": 3,
  "name": "Tango Paper Trader",
  "version": "0.2.13",
  "description": "Paper trade Solana meme tokens directly on GMGN with bilingual portfolio analytics.",
  "permissions": ["storage"],
  "host_permissions": ["https://gmgn.ai/*", "https://api.coingecko.com/*", "https://api.dexscreener.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Tango Paper Trader",
    "default_popup": "popup.html"
  },
  "options_page": "dashboard.html",
  "content_scripts": [
    {
      "matches": ["https://gmgn.ai/*"],
      "js": ["src/content/page-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://gmgn.ai/*"],
      "js": ["src/content/chart-main.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": ["https://gmgn.ai/*"],
      "css": ["src/content/content.css"],
      "js": [
        "src/shared/constants.js",
        "src/shared/i18n.js",
        "src/shared/format.js",
        "src/core/engine.js",
        "src/core/storage.js",
        "src/adapters/gmgn.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dashboard.html", "src/content/content.css"],
      "matches": ["https://gmgn.ai/*"]
    }
  ]
}
