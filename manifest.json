{
  "manifest_version": 3,
  "name": "Tango Paper Trader",
  "version": "0.3.3",
  "description": "Paper trade tokens across six GMGN chains with local, bilingual portfolio analytics.",
  "permissions": ["storage"],
  "host_permissions": ["https://gmgn.ai/*", "https://api.coingecko.com/*", "https://api.dexscreener.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Tango Paper Trader",
    "default_popup": "popup.html"
  },
  "commands": {
    "toggle-paper-trading-master": {
      "suggested_key": {
        "default": "Alt+Shift+Y"
      },
      "description": "Toggle all Tango paper trading features"
    }
  },
  "options_page": "dashboard.html",
  "content_scripts": [
    {
      "matches": ["https://gmgn.ai/*"],
      "css": ["src/content/quick-buy-safety.css"],
      "js": ["src/shared/constants.js", "src/content/native-quick-buy-guard.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://gmgn.ai/*"],
      "js": ["src/core/chains.js", "src/core/supply.js", "src/adapters/gmgn-quotes.js", "src/content/page-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://gmgn.ai/*"],
      "js": ["src/content/chart-main.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": ["https://gmgn.ai/*"],
      "css": ["src/content/content.css"],
      "js": [
        "src/core/chains.js",
        "src/core/supply.js",
        "src/shared/constants.js",
        "src/core/state.js",
        "src/shared/i18n.js",
        "src/shared/format.js",
        "src/core/engine.js",
        "src/core/state-coordinator.js",
        "src/core/storage.js",
        "src/adapters/gmgn-quotes.js",
        "src/adapters/gmgn.js",
        "src/content/chain-view.js",
        "src/content/markers.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dashboard.html", "src/content/content.css"],
      "matches": ["https://gmgn.ai/*"]
    }
  ]
}
